# ═══════════════════════════════════════════════════════════════════════════
# WhatsFRT - Variáveis de Ambiente PRODUÇÃO (VPS)
# ═══════════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env na VPS e preencha com valores reais

# ─── Banco de Dados PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=whatsfrt_prod
POSTGRES_PASSWORD=GERE_SENHA_FORTE_AQUI_32_CHARS
POSTGRES_DB=whatsfrt

# URL de conexão Prisma (aponta para localhost na VPS)
DATABASE_URL=postgresql://whatsfrt_prod:GERE_SENHA_FORTE_AQUI_32_CHARS@localhost:5432/whatsfrt?schema=public

# ─── Auth (JWT) ────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GERE_SECRET_64_CHARS_HEX_AQUI

# ─── Evolution API ─────────────────────────────────────────────────────────
# URL base da Evolution API (interna no Docker)
EVOLUTION_API_URL=http://localhost:8080

# Chave de autenticação da Evolution API (gere senha forte)
EVOLUTION_API_KEY=GERE_API_KEY_FORTE_AQUI

# URL pública da VPS onde a Evolution enviará webhooks
# Substitua SEU_IP_OU_DOMINIO pelo IP público da VPS ou domínio
EVOLUTION_WEBHOOK_URL=https://SEU_IP_OU_DOMINIO/api/webhooks/evolution

# URL pública da Evolution API (para QR code)
EVOLUTION_SERVER_URL=http://SEU_IP_OU_DOMINIO:8080

# Nome da instância WhatsApp
EVOLUTION_INSTANCE_NAME=whatsfrt

# Shared secret enviado pela Evolution no header `apikey` dos webhooks.
# OBRIGATÓRIO em produção. Sem ele, /api/webhook(s)/evolution retorna 403.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure também no container Evolution como WEBHOOK_GLOBAL_HEADER_APIKEY
EVOLUTION_WEBHOOK_SECRET=GERE_SECRET_64_CHARS_HEX_AQUI

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════
# INSTRUÇÕES DE DEPLOY NA VPS
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Conecte na VPS via SSH:
#    ssh root@SEU_IP_VPS
#
# 2. Instale Docker + Docker Compose:
#    curl -fsSL https://get.docker.com | sh
#    apt install docker-compose-plugin -y
#
# 3. Clone o repositório:
#    git clone https://github.com/SEU_USUARIO/whatsfrt.git
#    cd whatsfrt
#
# 4. Copie este arquivo:
#    cp env.production.template .env
#    nano .env  # Edite e preencha os valores
#
# 5. Suba os containers:
#    docker compose -f docker-compose.prod.yml up -d
#
# 6. Rode as migrations:
#    docker exec -it whatsfrt_postgres psql -U whatsfrt_prod -d whatsfrt -c "CREATE EXTENSION IF NOT EXISTS pgcrypto;"
#    # Depois rode as migrations do Prisma localmente apontando para a VPS
#
# 7. Crie o usuário admin:
#    npx tsx scripts/create-admin.ts admin@empresa.com SenhaForte123 "Admin Master"
#
# ═══════════════════════════════════════════════════════════════════════════
