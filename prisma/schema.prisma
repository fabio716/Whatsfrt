// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
}

enum Department {
  VENDAS
  FINANCEIRO
  GERENCIA
  SUPORTE
  ATENDIMENTO
  COBRANCA
  MARKETING
  TI
  RH
  COMERCIAL
  EXPEDICAO
  POS_VENDAS
  SECRETARIA_ASSISTENCIA
  TECNICOS_ASSISTENCIA
}

enum ChatStatus {
  IDLE
  IN_URA
  WAITING_AGENT
  IN_SERVICE
  AWAITING_RATING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CampaignLogStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Usuários do sistema. Acesso revogado via isActive=false (nunca hard-delete).
model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password")
  role         Role        @default(AGENT)
  department   Department?
  isActive     Boolean     @default(true)
  // Foto de perfil do próprio usuário (interna) — mostrada no chat da equipe.
  photoUrl     String?
  // Limite diário de mensagens OUTBOUND iniciadas por este usuário.
  // Protege contra anti-spam do WhatsApp. Admin pode ajustar em /admin/users.
  // 0 = ilimitado.
  dailyMessageLimit Int    @default(150)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  messages         Message[]
  assignedContacts Contact[] @relation("AssignedContacts")
  cooperatives     Cooperative[] @relation("CooperativeAssignments")
  serviceSessions  ServiceSession[] @relation("AgentSessions")

  @@map("users")
}

// Contato externo identificado pelo número WhatsApp.
model Contact {
  id              String    @id @default(cuid())
  whatsappId      String    @unique
  name            String
  profilePhotoUrl String?
  chatStatus      ChatStatus @default(IDLE)
  assignedUserId  String?
  assignedUser    User?      @relation("AssignedContacts", fields: [assignedUserId], references: [id])
  cooperativeId   String?
  cooperative     Cooperative? @relation(fields: [cooperativeId], references: [id])

  // Timestamps do ciclo de atendimento. Setadas quando o chatStatus muda:
  //   waitingAgentSince → ao entrar em WAITING_AGENT
  //   inServiceSince    → ao entrar em IN_SERVICE
  // Usadas pela tela "Equipe ao vivo" para mostrar tempo de espera/atendimento.
  waitingAgentSince DateTime?
  inServiceSince    DateTime?

  // Dados comerciais — busca/filtro na tela "Clientes Cadastrados".
  empresa  String?
  cidade   String?

  // Departamento alvo que o cliente escolheu na URA (ex: "VENDAS", "FINANCEIRO").
  // Populado quando o contato entra em WAITING_AGENT vindo da URA. Usado pela
  // pagina Fila de espera pra mostrar cada contato APENAS pros agentes do
  // setor escolhido — agente de Vendas nao ve fila do Financeiro e vice versa.
  pendingDepartment String?

  // Marco de "recomeço" do chat. Quando um contato é ASSUMIDO de outro agente,
  // é setado para now() — o chat passa a mostrar só as mensagens a partir daqui,
  // sem herdar o histórico do agente anterior (atendimento começa limpo).
  historyResetAt  DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  messages        Message[]
  campaignLogs    CampaignLog[]
  serviceSessions ServiceSession[]

  @@index([assignedUserId])
  @@index([cooperativeId])
  @@index([chatStatus])
  @@index([pendingDepartment])
  @@map("contacts")
}

// Cada atendimento completo (de pegou → encerrou) vira uma ServiceSession.
// Mesmo contato pode ter N sessions ao longo do tempo. Usada para:
//   1. Histórico de atendimentos por agente
//   2. Cálculo de tempo de espera/duração
//   3. Avaliação do cliente (rating + comment)
model ServiceSession {
  id                String   @id @default(cuid())
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agentId           String
  agent             User     @relation("AgentSessions", fields: [agentId], references: [id])

  // Ciclo
  waitingFrom       DateTime  // quando o contato entrou em fila (WAITING_AGENT)
  startedAt         DateTime  // quando o agente assumiu (IN_SERVICE)
  endedAt           DateTime? // quando o agente encerrou (botão ou auto)

  // Avaliação
  ratingRequestedAt DateTime?
  rating            Int?      // 1-5 (CSAT)
  comment           String?
  ratedAt           DateTime?

  // Encerramento forçado por inatividade (>30 min sem mensagem)
  autoEnded         Boolean   @default(false)

  createdAt         DateTime  @default(now())

  @@index([agentId, startedAt])
  @@index([contactId])
  @@index([endedAt, rating])
  @@map("service_sessions")
}

// Mensagem trocada entre um Contact e um User (agente).
model Message {
  id        String           @id @default(cuid())
  body      String
  direction MessageDirection
  status    MessageStatus    @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  mediaUrl  String?
  mediaType String?

  // Idempotência inbound: key.id da Evolution. Evita gravar 2x se a Evolution
  // reenviar o webhook (timeout dela, restart nosso, etc).
  whatsappKeyId String? @unique

  // Idempotência outbound: cliente passa Idempotency-Key no header.
  // Botão "enviar" clicado N vezes = 1 mensagem.
  clientKey String? @unique

  // Última falha registrada (reaper, retry esgotado, etc) — visível na UI.
  errorMsg String?

  // Quantas vezes o pipeline de envio rodou para esta mensagem (retry).
  attempts Int @default(0)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  agentId String?
  agent   User?   @relation(fields: [agentId], references: [id])

  @@index([status, createdAt])
  @@map("messages")
}

// Configuração singleton da URA (IVR). Criada automaticamente no primeiro uso.
model UraConfig {
  id                 String   @id @default(cuid())
  greetingText       String   @default("Olá! 👋 Como podemos te ajudar?\n\nResponda com o número da opção desejada.")
  isActive           Boolean  @default(true)
  outOfOfficeMessage String   @default("No momento estamos fora do horário de atendimento. Deixe sua mensagem que retornaremos em breve!")
  lunchMessage       String   @default("Estamos em horário de almoço. Retornaremos às 13h.")
  
  // Mensagens do fluxo comercial
  askNameMessage     String   @default("Por favor, digite seu nome completo:")
  askProfileMessage  String   @default("Você é:\n1️⃣ Pessoa Física\n2️⃣ Pessoa Jurídica")
  askSectorMessage   String   @default("Qual setor deseja?\n1️⃣ Financeiro\n2️⃣ Suporte\n3️⃣ Vendas\n0️⃣ Voltar")
  
  // Mensagens do fluxo noturno
  nightAskNameMessage    String @default("Obrigado por entrar em contato! Por favor, informe seu nome:")
  nightAskSectorMessage  String @default("Qual o setor de interesse?\n1️⃣ Financeiro\n2️⃣ Suporte\n3️⃣ Vendas")
  nightAskSubjectMessage String @default("Por favor, descreva brevemente o assunto:")
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  options       UraMenuOption[]
  businessHours BusinessHour[]
  nightOffer    NightOffer?

  @@map("ura_config")
}

// Cada linha do menu da URA (dígito → label → departamento).
model UraMenuOption {
  id               String    @id @default(cuid())
  digit            String
  label            String
  targetDepartment String
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  configId String
  config   UraConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, digit])
  @@map("ura_menu_options")
}

// Horário de atendimento por dia da semana (0=Dom … 6=Sáb).
model BusinessHour {
  id            String    @id @default(cuid())
  dayOfWeek     Int
  isClosed      Boolean   @default(false)
  openTime      String    @default("08:00")
  closeTime     String    @default("18:00")
  hasLunchBreak Boolean   @default(false)
  lunchStart    String    @default("12:00")
  lunchEnd      String    @default("13:00")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  configId String
  config   UraConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, dayOfWeek])
  @@map("business_hours")
}

// Campanha de disparo em massa.
model Campaign {
  id          String         @id @default(cuid())
  name        String
  messageText String
  mediaUrl    String?
  mediaType   String?
  status      CampaignStatus @default(PENDING)
  createdById String?
  createdAt   DateTime       @default(now())
  
  // Proteções e limites
  maxPerDay   Int            @default(200)
  maxPerHour  Int            @default(30)
  delayMin    Int            @default(3)  // segundos
  delayMax    Int            @default(8)  // segundos
  pausedAt    DateTime?
  errorCount  Int            @default(0)
  deliveryRate Float         @default(0)  // % de entregas bem-sucedidas

  logs CampaignLog[]

  @@map("campaigns")
}

// Log individual de envio por contato em uma campanha.
model CampaignLog {
  id         String            @id @default(cuid())
  status     CampaignLogStatus @default(PENDING)
  messageKeyId String?
  sentAt     DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  errorMsg   String?
  blockedByContact Boolean       @default(false)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([messageKeyId])
  @@map("campaign_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Motor da URA - State Machine
// ═══════════════════════════════════════════════════════════════════════════

// Sessão da URA (State Machine) armazenada no Redis e persistida no BD
model UraSession {
  id            String   @id @default(cuid())
  whatsappId    String   @unique
  currentNode   String   // ex: "greeting", "ask_profile", "ask_sector", etc
  previousNode  String?  // Para navegação com "0" (voltar)
  isNightFlow   Boolean  @default(false)
  
  // Dados coletados durante o fluxo
  collectedName    String?
  collectedProfile String? // "PF" ou "PJ"
  collectedSector  String? // "FINANCEIRO", "SUPORTE", "VENDAS"
  collectedSubject String? // Assunto (fluxo noturno)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime // TTL para limpeza automática

  @@index([whatsappId])
  @@index([expiresAt])
  @@map("ura_sessions")
}

// Cooperativas (B2B) - Tab 3
model Cooperative {
  id          String   @id @default(cuid())
  name        String   // ex: "Sicoob", "Sicredi", "Cresol"
  cnpjBase    String?  // CNPJ base (8 primeiros dígitos)
  isActive    Boolean  @default(true)
  
  // Atendente B2B responsável
  assignedUserId String?
  assignedUser   User?   @relation("CooperativeAssignments", fields: [assignedUserId], references: [id])

  contacts    Contact[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cooperatives")
}

// Histórico de requisição/transferência de carteira.
// Registrado sempre que um cliente é trazido para a carteira de um vendedor
// via "Requisitar cliente". Guarda snapshots dos nomes (contato/vendedores)
// para o histórico sobreviver a mudanças de nome ou desativação de usuários.
// Tabela puramente aditiva: não referencia (FK) contacts/users de propósito,
// para o log não ser apagado se o contato/usuário for removido.
model ContactTransferLog {
  id           String   @id @default(cuid())
  contactId    String
  contactName  String   // snapshot do nome do cliente no momento
  fromUserId   String?  // vendedor anterior (null se estava sem carteira)
  fromUserName String?  // snapshot do nome do vendedor anterior
  toUserId     String   // vendedor que requisitou (novo dono)
  toUserName   String   // snapshot do nome do novo dono
  createdAt    DateTime @default(now())

  @@index([contactId])
  @@index([toUserId])
  @@index([fromUserId])
  @@map("contact_transfer_logs")
}

// Solicitação de transferência de atendimento. Criada quando um vendedor pede
// pra assumir um cliente que JÁ está em atendimento com outro. Precisa ser
// aprovada pelo dono atual OU por um admin antes do cliente mudar de carteira.
model ContactTransferRequest {
  id            String    @id @default(cuid())
  contactId     String
  contactName   String    // snapshot
  fromUserId    String    // dono atual (pode aprovar, junto com admin)
  fromUserName  String
  requesterId   String    // quem pediu (vira o novo dono se aprovado)
  requesterName String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById   String?
  decidedByName String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([status])
  @@index([fromUserId, status])
  @@index([requesterId, status])
  @@index([contactId, status])
  @@map("contact_transfer_requests")
}

// ═══════════════════════════════════════════════════════════════════════════
// Chat interno da equipe (usuário ↔ usuário). Independente do WhatsApp.
// Suporta conversa 1:1 (isGroup=false, 2 membros) e grupos (isGroup=true).
// ═══════════════════════════════════════════════════════════════════════════

model InternalConversation {
  id          String   @id @default(cuid())
  isGroup     Boolean  @default(false)
  name        String?  // nome do grupo (null em conversa 1:1)
  createdById String?
  createdAt   DateTime @default(now())
  // Atualizado a cada nova mensagem — usado pra ordenar a lista de conversas.
  updatedAt   DateTime @default(now()) @updatedAt

  members  InternalConversationMember[]
  messages InternalMessage[]

  @@index([updatedAt])
  @@map("internal_conversations")
}

model InternalConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  // Marca até quando o usuário leu — base pra contar mensagens não lidas.
  lastReadAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("internal_conversation_members")
}

model InternalMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  mediaUrl       String?
  mediaType      String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("internal_messages")
}

// Territórios de Vendas (Geográfico) - Tab 4
model Territory {
  id       String   @id @default(cuid())
  uf       String   @unique // UF do Brasil (ex: "SP", "RJ", "MG")
  isActive Boolean  @default(true)
  
  // Atendentes de vendas (pode ter múltiplos - Round Robin)
  assignedUserIds String[] // Array de IDs de usuários
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("territories")
}

// Oferta Noturna (Cupom de Desconto) - Tab 2
model NightOffer {
  id             String   @id @default(cuid())
  isActive       Boolean  @default(false)
  couponCode     String   @default("")
  discountType   String   @default("percentage") // "percentage" ou "fixed"
  discountValue  Float    @default(0)
  storeUrl       String   @default("")
  offerMessage   String   @default("🎁 Oferta especial! Use o cupom {coupon} e ganhe {discount} de desconto!\n\nAcesse: {url}")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  configId String  @unique
  config   UraConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("night_offers")
}
