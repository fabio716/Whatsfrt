// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
}

enum Department {
  VENDAS
  FINANCEIRO
  GERENCIA
  SUPORTE
  ATENDIMENTO
  COBRANCA
  MARKETING
  TI
  RH
  COMERCIAL
}

enum ChatStatus {
  IDLE
  IN_URA
  WAITING_AGENT
  IN_SERVICE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CampaignLogStatus {
  PENDING
  SENT
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

// Usuários do sistema. Acesso revogado via isActive=false (nunca hard-delete).
model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password")
  role         Role        @default(AGENT)
  department   Department?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  messages         Message[]
  assignedContacts Contact[] @relation("AssignedContacts")
  cooperatives     Cooperative[] @relation("CooperativeAssignments")

  @@map("users")
}

// Contato externo identificado pelo número WhatsApp.
model Contact {
  id              String    @id @default(cuid())
  whatsappId      String    @unique
  name            String
  profilePhotoUrl String?
  chatStatus      ChatStatus @default(IDLE)
  assignedUserId  String?
  assignedUser    User?      @relation("AssignedContacts", fields: [assignedUserId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  messages     Message[]
  campaignLogs CampaignLog[]

  @@map("contacts")
}

// Mensagem trocada entre um Contact e um User (agente).
model Message {
  id        String           @id @default(cuid())
  body      String
  direction MessageDirection
  status    MessageStatus    @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  mediaUrl  String?
  mediaType String?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  agentId String?
  agent   User?   @relation(fields: [agentId], references: [id])

  @@map("messages")
}

// Configuração singleton da URA (IVR). Criada automaticamente no primeiro uso.
model UraConfig {
  id                 String   @id @default(cuid())
  greetingText       String   @default("Olá! 👋 Como podemos te ajudar?\n\nResponda com o número da opção desejada.")
  isActive           Boolean  @default(true)
  outOfOfficeMessage String   @default("No momento estamos fora do horário de atendimento. Deixe sua mensagem que retornaremos em breve!")
  lunchMessage       String   @default("Estamos em horário de almoço. Retornaremos às 13h.")
  
  // Mensagens do fluxo comercial
  askNameMessage     String   @default("Por favor, digite seu nome completo:")
  askProfileMessage  String   @default("Você é:\n1️⃣ Pessoa Física\n2️⃣ Pessoa Jurídica")
  askSectorMessage   String   @default("Qual setor deseja?\n1️⃣ Financeiro\n2️⃣ Suporte\n3️⃣ Vendas\n0️⃣ Voltar")
  
  // Mensagens do fluxo noturno
  nightAskNameMessage    String @default("Obrigado por entrar em contato! Por favor, informe seu nome:")
  nightAskSectorMessage  String @default("Qual o setor de interesse?\n1️⃣ Financeiro\n2️⃣ Suporte\n3️⃣ Vendas")
  nightAskSubjectMessage String @default("Por favor, descreva brevemente o assunto:")
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  options       UraMenuOption[]
  businessHours BusinessHour[]
  nightOffer    NightOffer?

  @@map("ura_config")
}

// Cada linha do menu da URA (dígito → label → departamento).
model UraMenuOption {
  id               String    @id @default(cuid())
  digit            String
  label            String
  targetDepartment String
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  configId String
  config   UraConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, digit])
  @@map("ura_menu_options")
}

// Horário de atendimento por dia da semana (0=Dom … 6=Sáb).
model BusinessHour {
  id            String    @id @default(cuid())
  dayOfWeek     Int
  isClosed      Boolean   @default(false)
  openTime      String    @default("08:00")
  closeTime     String    @default("18:00")
  hasLunchBreak Boolean   @default(false)
  lunchStart    String    @default("12:00")
  lunchEnd      String    @default("13:00")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  configId String
  config   UraConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, dayOfWeek])
  @@map("business_hours")
}

// Campanha de disparo em massa.
model Campaign {
  id          String         @id @default(cuid())
  name        String
  messageText String
  status      CampaignStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  
  // Proteções e limites
  maxPerDay   Int            @default(200)
  maxPerHour  Int            @default(30)
  delayMin    Int            @default(3)  // segundos
  delayMax    Int            @default(8)  // segundos
  pausedAt    DateTime?
  errorCount  Int            @default(0)
  deliveryRate Float         @default(0)  // % de entregas bem-sucedidas

  logs CampaignLog[]

  @@map("campaigns")
}

// Log individual de envio por contato em uma campanha.
model CampaignLog {
  id         String            @id @default(cuid())
  status     CampaignLogStatus @default(PENDING)
  sentAt     DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  errorMsg   String?
  blockedByContact Boolean       @default(false)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("campaign_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Motor da URA - State Machine
// ═══════════════════════════════════════════════════════════════════════════

// Sessão da URA (State Machine) armazenada no Redis e persistida no BD
model UraSession {
  id            String   @id @default(cuid())
  whatsappId    String   @unique
  currentNode   String   // ex: "greeting", "ask_profile", "ask_sector", etc
  previousNode  String?  // Para navegação com "0" (voltar)
  isNightFlow   Boolean  @default(false)
  
  // Dados coletados durante o fluxo
  collectedName    String?
  collectedProfile String? // "PF" ou "PJ"
  collectedSector  String? // "FINANCEIRO", "SUPORTE", "VENDAS"
  collectedSubject String? // Assunto (fluxo noturno)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime // TTL para limpeza automática

  @@index([whatsappId])
  @@index([expiresAt])
  @@map("ura_sessions")
}

// Cooperativas (B2B) - Tab 3
model Cooperative {
  id          String   @id @default(cuid())
  name        String   // ex: "Sicoob", "Sicredi", "Cresol"
  cnpjBase    String?  // CNPJ base (8 primeiros dígitos)
  isActive    Boolean  @default(true)
  
  // Atendente B2B responsável
  assignedUserId String?
  assignedUser   User?   @relation("CooperativeAssignments", fields: [assignedUserId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cooperatives")
}

// Territórios de Vendas (Geográfico) - Tab 4
model Territory {
  id       String   @id @default(cuid())
  uf       String   @unique // UF do Brasil (ex: "SP", "RJ", "MG")
  isActive Boolean  @default(true)
  
  // Atendentes de vendas (pode ter múltiplos - Round Robin)
  assignedUserIds String[] // Array de IDs de usuários
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("territories")
}

// Oferta Noturna (Cupom de Desconto) - Tab 2
model NightOffer {
  id             String   @id @default(cuid())
  isActive       Boolean  @default(false)
  couponCode     String   @default("")
  discountType   String   @default("percentage") // "percentage" ou "fixed"
  discountValue  Float    @default(0)
  storeUrl       String   @default("")
  offerMessage   String   @default("🎁 Oferta especial! Use o cupom {coupon} e ganhe {discount} de desconto!\n\nAcesse: {url}")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  configId String  @unique
  config   UraConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("night_offers")
}
