# ─── Banco de Dados (PostgreSQL) ─────────────────────────────────────────────
# Credenciais usadas pelo container postgres no docker-compose.yml
POSTGRES_USER="whatsfrt"
POSTGRES_PASSWORD="whatsfrt"
POSTGRES_DB="whatsfrt"

# URL de conexão do Prisma (aponta para o container local)
DATABASE_URL="postgresql://whatsfrt:whatsfrt@localhost:5432/whatsfrt?schema=public"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-random-64-char-hex-secret"

# ─── Evolution API ────────────────────────────────────────────────────────────
# URL base onde a Evolution API está rodando (container Docker)
EVOLUTION_API_URL="http://localhost:8080"

# Chave de autenticação definida em docker-compose.yml
EVOLUTION_API_KEY="change-me-to-a-strong-api-key"

# URL que a Evolution API usará para enviar webhooks ao Next.js
EVOLUTION_WEBHOOK_URL="http://host.docker.internal:3000/api/webhook/evolution"

# Nome da instância WhatsApp criada na Evolution API
EVOLUTION_INSTANCE_NAME="whatsfrt"

# ─── Redis (usado internamente pela Evolution API via Docker) ─────────────────
REDIS_URL="redis://localhost:6379"
